---
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow-condensed/800.css";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import Nav from "../components/Nav.astro";

const { title, current = "", description, wide = false } = Astro.props;
const siteName = "Banff Canmore Speed Skating";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${siteName}` : `${siteName} — Bow Valley`}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#001b52" />
    <link rel="icon" href="/media/2020_09_BCSSCLogo-Modified-1.png" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header>
      <div class="bar">
        <a href="/" class="brand" aria-label={siteName}>
          <Image src={logo} alt={siteName} widths={[260, 420]} sizes="220px" loading="eager" />
        </a>
        <Nav current={current} />
      </div>
    </header>

    <main id="main" class={wide ? "wide" : ""}>
      {title && <h1>{title}</h1>}
      <slot />
    </main>

    <footer>
      <div class="finner">
        <div>
          <p class="fname">{siteName}</p>
          <p>Canmore Recreation Centre &middot; 1900 8 Ave, Canmore</p>
          <p>P.O. Box 8425, Canmore, AB T1W 2V2</p>
        </div>
        <div>
          <p><a href="mailto:communication@banffcanmorespeedskating.ca">communication@banffcanmorespeedskating.ca</a></p>
          <p><a href="https://www.facebook.com/banffcanmorespeedskating">Facebook</a> &middot; <a href="https://www.instagram.com/banffcanmorespeedskating">Instagram</a></p>
          <p class="tiny">A member of True Sport, committed to the True Sport Principles.</p>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --navy: #001b52; --navy-2: #00246d; --blue: #0059cb; --blue-lt: #2f82f5;
        --yellow: #ffd100; --ink: #14181d; --muted: #5b6672;
        --line: #dbe2ec; --bg: #fff; --surface: #f4f7fc;
        --display: "Barlow Condensed", system-ui, sans-serif;
        --body: "Barlow", system-ui, -apple-system, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --ink: #e9eef6; --muted: #a3b1c2; --line: #223049;
          --bg: #0a1020; --surface: #101a30; --blue: #6aa6f8; --blue-lt: #94c2fb;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.7 var(--body); }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 8px; top: 8px; background: var(--yellow); color: #000; padding: 10px 14px; z-index: 20; font-weight: 700; }

      header { background: var(--navy); border-bottom: 4px solid var(--yellow); }
      .bar { max-width: 1120px; margin: 0 auto; padding: 14px 20px;
             display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; justify-content: space-between; }
      .brand img { width: 220px; height: auto; display: block; }

      nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 2px 20px; margin: 0; padding: 0; align-items: center; }
      nav a, nav .group > span {
        font-family: var(--display); font-weight: 700; font-size: 18px; letter-spacing: .02em;
        text-transform: uppercase; text-decoration: none; color: #fff; padding: 6px 0;
        border-bottom: 3px solid transparent; display: inline-block;
      }
      nav a:hover { color: var(--yellow); border-bottom-color: var(--yellow); }
      nav a.active { color: var(--yellow); border-bottom-color: var(--yellow); }
      nav .group { position: relative; }
      nav .group > span { color: #9fb6dd; cursor: default; }
      nav .group > span::after { content: " \25BE"; font-size: 12px; }
      nav .group > ul { gap: 2px 14px; margin-left: 10px; }
      nav .group > ul a { font-size: 15px; color: #cfe0f7; }

      /* Desktop: keep the bar to one row - the group becomes a hover dropdown. */
      @media (min-width: 861px) {
        nav .group > ul {
          display: none; position: absolute; left: -14px; top: calc(100% + 6px); z-index: 30;
          flex-direction: column; align-items: flex-start; gap: 2px; min-width: 210px;
          background: var(--navy-2); border: 1px solid rgba(255,255,255,.18);
          border-top: 3px solid var(--yellow); border-radius: 6px;
          padding: 12px 18px; box-shadow: 0 14px 34px rgba(0,0,0,.42);
        }
        nav .group:hover > ul,
        nav .group:focus-within > ul { display: flex; }
        nav .group > span { cursor: pointer; }
        nav .group:hover > span { color: var(--yellow); }
      }

      main { max-width: 780px; margin: 0 auto; padding: 44px 20px 72px; }
      main.wide { max-width: 1120px; }
      h1 { font-family: var(--display); font-weight: 800; text-transform: uppercase;
           font-size: clamp(34px, 6vw, 54px); line-height: 1.02; letter-spacing: .01em;
           margin: 0 0 22px; color: var(--navy); }
      @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) h1 { color: var(--blue-lt); } }
      h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase;
           font-size: clamp(25px, 3.6vw, 34px); line-height: 1.1; margin: 44px 0 14px; }
      h3 { font-family: var(--display); font-weight: 700; text-transform: uppercase;
           font-size: 21px; letter-spacing: .02em; margin: 30px 0 8px; }
      p { margin: 0 0 16px; }
      a { color: var(--blue); }
      img { max-width: 100%; height: auto; }
      ul, ol { padding-left: 22px; }
      li { margin: 4px 0; }
      hr { border: 0; border-top: 1px solid var(--line); margin: 40px 0; }

      .cta, .cta-lg {
        display: inline-block; background: var(--yellow); color: #001b52;
        font-family: var(--display); font-weight: 800; text-transform: uppercase;
        letter-spacing: .03em; text-decoration: none; border-radius: 4px;
        padding: 13px 26px; font-size: 19px; transition: transform .12s ease, filter .12s ease;
      }
      .cta-lg { font-size: 23px; padding: 16px 34px; }
      .cta:hover, .cta-lg:hover { filter: brightness(1.07); transform: translateY(-1px); }
      .cta-ghost {
        display: inline-block; border: 2px solid #fff; color: #fff; background: transparent;
        font-family: var(--display); font-weight: 700; text-transform: uppercase;
        padding: 13px 24px; border-radius: 4px; text-decoration: none; font-size: 19px;
      }
      .cta-ghost:hover { background: #fff; color: var(--navy); }

      .card { border: 1px solid var(--line); border-left: 5px solid var(--yellow);
              border-radius: 6px; padding: 20px 24px; margin: 18px 0; background: var(--surface); }
      .card h3 { margin-top: 0; }
      .card p:last-child { margin-bottom: 0; }
      .meta { color: var(--muted); font-size: 15px; font-weight: 600; text-transform: uppercase;
              letter-spacing: .04em; font-family: var(--display); }
      .embed { position: relative; padding-top: 75%; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); }
      .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
      .pagefig { border-radius: 8px; overflow: hidden; margin: 0 0 30px; }
      .pagefig img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: center 40%; }
      @media (max-width: 560px) { .pagefig img { aspect-ratio: 3 / 2; } }
      /* Portrait posters: shown whole, never cropped. */
      .posterfig { margin: 0 0 30px; text-align: center; }
      .posterfig img {
        display: inline-block; width: 100%; max-width: 440px; height: auto;
        border-radius: 8px; border: 1px solid var(--line);
        box-shadow: 0 6px 24px rgba(0,0,0,.14);
      }

      footer { background: var(--navy); color: #c8d8ef; margin-top: 60px; }
      .finner { max-width: 1120px; margin: 0 auto; padding: 36px 20px;
                display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); font-size: 15px; }
      footer p { margin: 3px 0; }
      footer a { color: var(--yellow); }
      .fname { font-family: var(--display); font-weight: 800; text-transform: uppercase;
               font-size: 21px; color: #fff; letter-spacing: .02em; }
      .tiny { font-size: 13px; color: #8ba5cc; margin-top: 10px; }

      /* Checkbox toggle: no <details> UA behaviour to fight in flex layout. */
      .navtoggle { position: absolute; width: 1px; height: 1px; opacity: 0; }
      .burgerbtn { display: none; }
      @media (max-width: 860px) {
        .bar { flex-wrap: nowrap; }
        .brand img { width: 172px; }
        .burgerbtn {
          display: flex; align-items: center; gap: 9px; cursor: pointer;
          font-family: var(--display); font-weight: 800; text-transform: uppercase;
          font-size: 18px; color: #fff; padding: 9px 13px;
          border: 2px solid rgba(255,255,255,.4); border-radius: 4px; user-select: none;
        }
        .navtoggle:checked ~ .burgerbtn { border-color: var(--yellow); color: var(--yellow); }
        .navtoggle:focus-visible ~ .burgerbtn { outline: 3px solid var(--yellow); outline-offset: 2px; }
        .burger, .burger::before, .burger::after {
          display: block; width: 19px; height: 2px; background: currentColor; content: "";
        }
        .burger { position: relative; }
        .burger::before { position: absolute; top: -6px; }
        .burger::after { position: absolute; top: 6px; }
        header { position: relative; }
        nav { display: none; }
        .navtoggle:checked ~ nav {
          display: block; position: absolute; right: 16px; top: 100%; z-index: 30;
          background: var(--navy-2); border: 1px solid rgba(255,255,255,.18);
          border-top: 3px solid var(--yellow); border-radius: 6px;
          padding: 14px 20px; min-width: 232px; box-shadow: 0 14px 34px rgba(0,0,0,.42);
        }
        .navtoggle:checked ~ nav > ul { flex-direction: column; align-items: flex-start; gap: 3px; }
        .navtoggle:checked ~ nav .group > ul { flex-direction: column; align-items: flex-start; margin-left: 12px; }
      }
    </style>
  </body>
</html>
