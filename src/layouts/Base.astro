---
import Nav from "../components/Nav.astro";
const { title, current = "", description } = Astro.props;
const siteName = "Banff Canmore Speed Skating";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/media/2020_09_BCSSCLogo-Modified-1.png" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <header>
      <a href="/" class="brand">
        <img src="/media/2015_06_BCSSCLogo.png" alt={siteName} />
      </a>
      <Nav current={current} />
    </header>
    <main id="main">
      {title && <h1>{title}</h1>}
      <slot />
    </main>
    <footer>
      <p><strong>{siteName}</strong></p>
      <p>P.O. Box 8425, Canmore, AB T1W 2V2</p>
      <p><a href="mailto:communication@banffcanmorespeedskating.ca">communication@banffcanmorespeedskating.ca</a></p>
    </footer>
    <style is:global>
      :root {
        --blue: #0b4da2; --blue-dark: #07356f; --yellow: #ffd400;
        --ink: #14181d; --muted: #5b6672; --line: #dde3ea; --bg: #fff; --surface: #f6f8fb;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --ink: #e8edf3; --muted: #9dabb9; --line: #26303a; --bg: #0f1419; --surface: #161d25;
          --blue: #5b9bf0; --blue-dark: #8fbcf7;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 8px; top: 8px; background: var(--yellow); color: #000; padding: 8px 12px; z-index: 10; }
      header {
        display: flex; flex-wrap: wrap; gap: 16px; align-items: center;
        justify-content: space-between; padding: 16px;
        border-bottom: 3px solid var(--yellow); background: var(--surface);
      }
      .brand img { height: 52px; width: auto; display: block; }
      nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 0; padding: 0; }
      nav a, nav .group > span {
        text-decoration: none; color: var(--ink); font-weight: 600; font-size: 15px;
        padding: 6px 2px; display: inline-block; border-bottom: 2px solid transparent;
      }
      nav a:hover { color: var(--blue); border-bottom-color: var(--blue); }
      nav a.active { color: var(--blue); border-bottom-color: var(--yellow); }
      nav .group > span { color: var(--muted); cursor: default; }
      nav .group > ul { gap: 4px 12px; margin-left: 10px; }
      nav .group > ul a { font-weight: 500; font-size: 14px; }
      main { max-width: 760px; margin: 0 auto; padding: 32px 16px 56px; }
      h1 { font-size: clamp(28px, 5vw, 38px); line-height: 1.15; margin: 0 0 24px; color: var(--blue); }
      h2 { font-size: 24px; margin: 36px 0 12px; }
      h3 { font-size: 19px; margin: 28px 0 8px; }
      a { color: var(--blue); }
      img { max-width: 100%; height: auto; }
      ul, ol { padding-left: 22px; }
      hr { border: 0; border-top: 1px solid var(--line); margin: 32px 0; }
      .cta {
        display: inline-block; background: var(--blue); color: #fff; font-weight: 700;
        padding: 12px 22px; border-radius: 6px; text-decoration: none; margin: 8px 0;
      }
      .cta:hover { background: var(--blue-dark); }
      .card { border: 1px solid var(--line); border-radius: 8px; padding: 18px 20px; margin: 16px 0; background: var(--surface); }
      .card h3 { margin-top: 0; }
      .meta { color: var(--muted); font-size: 14px; }
      .embed { position: relative; padding-top: 75%; }
      .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
      footer {
        border-top: 1px solid var(--line); background: var(--surface);
        padding: 28px 16px; text-align: center; color: var(--muted); font-size: 14px;
      }
      footer p { margin: 4px 0; }
      @media (max-width: 640px) {
        header { flex-direction: column; align-items: flex-start; }
        nav ul { gap: 4px 14px; }
      }
    </style>
  </body>
</html>
