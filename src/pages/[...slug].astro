---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages
    .filter((p) => p.id !== "home" && p.id !== "news")
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { hero, heroAlt, title } = page.data;
---
<Base title={title} current={page.id}>
  {hero && (
    <figure class="pagefig">
      <Image src={hero} alt={heroAlt ?? ""} widths={[760, 1200]} sizes="(max-width: 820px) 100vw, 780px" />
    </figure>
  )}
  <Content />
</Base>
