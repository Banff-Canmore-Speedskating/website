---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import hero from "../../assets/team-hoodies-2026.jpg";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="News" current="news">
  <figure class="pagefig">
    <Image src={hero} alt="The whole club in our new blue hoodies at Club Race Night #1"
           widths={[760, 1200]} sizes="(max-width: 820px) 100vw, 780px"
           style="object-position:center 35%" />
  </figure>
  {posts.map((p) => (
    <div class="card">
      <h3><a href={`/news/${p.id}/`}>{p.data.title}</a></h3>
      <p class="meta">
        {p.data.date.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
      </p>
    </div>
  ))}

  <style>
    .card h3 a { color: inherit; text-decoration: none; }
    .card h3 a:hover { color: var(--blue); text-decoration: underline; }
  </style>
</Base>
