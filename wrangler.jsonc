{
  // Static-assets-only Worker: no `main`, so no `assets.binding` either.
  // Deployed by Cloudflare Workers Builds on push to main.
  "name": "website",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
