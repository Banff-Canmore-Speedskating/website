{
  // Worker script handles legacy ?page_id= / ?p= redirects, then falls through
  // to static assets. `binding` is required because `main` is set.
  //
  // `run_worker_first` is essential: by default Workers serves a matching static
  // asset WITHOUT invoking the Worker, so "/?page_id=1453" would match index.html
  // and the redirect would never run. Scoped to "/" because that is the only path
  // legacy WordPress URLs ever use - everything else goes straight to assets.
  "name": "website",
  "compatibility_date": "2026-09-23",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/"]
  }
}
